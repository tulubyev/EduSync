NODE_ENV=production

# ── База данных (та же, что у основного приложения) ───────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ── Beget S3 ──────────────────────────────────────────────────────────────────
BEGET_S3_ENDPOINT=https://s3.ru1.storage.beget.cloud
BEGET_S3_ACCESS_KEY=
BEGET_S3_SECRET_KEY=
BEGET_S3_BUCKET=
BEGET_S3_REGION=ru-1
# Необязательно: без него ссылки строятся как <ENDPOINT>/<BUCKET>/... (бакет должен быть публичным на чтение)
# BEGET_S3_PUBLIC_URL=

# ── Настройки воркера ────────────────────────────────────────────────────────
WORKER_ID=vps-worker-1
MAX_WORKERS=1
POLL_INTERVAL_MS=5000
HEARTBEAT_INTERVAL_MS=30000
HEARTBEAT_TIMEOUT_MS=600000
SCHEDULED_TIME_TZ_OFFSET_H=3

# ── Chromium ─────────────────────────────────────────────────────────────────
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium-browser
CHROMIUM_HEADLESS=true

# ── Запись ───────────────────────────────────────────────────────────────────
RECORDINGS_DIR=/tmp/recordings
