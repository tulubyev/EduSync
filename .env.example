# ===========================================
# My EPA (EduSync) — Environment Configuration
# ===========================================
# Скопируйте этот файл в .env и заполните реальными значениями

# ===========================================
# ОСНОВНЫЕ НАСТРОЙКИ
# ===========================================
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# ===========================================
# БАЗА ДАННЫХ
# ===========================================
DATABASE_URL=postgresql://username:password@hostname:port/database
# false — PostgreSQL на том же сервере/в Docker-сети (VPS 172.28.0.1); true — облачная БД (Beget и т.п.)
DATABASE_SSL=false
DATABASE_MAX_CONNECTIONS=10
DATABASE_CONNECTION_TIMEOUT=30000
DATABASE_QUERY_TIMEOUT=60000

# ===========================================
# КРИПТОГРАФИЯ И БЕЗОПАСНОСТЬ
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters
JWT_REFRESH_SECRET=your-refresh-secret-key-minimum-32-characters
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SESSION_SECRET=your-session-secret-key-minimum-32-characters

# ===========================================
# RATE LIMITING НАСТРОЙКИ
# ===========================================
# General API rate limits
RATE_LIMIT_GENERAL_WINDOW_MS=900000
RATE_LIMIT_GENERAL_MAX=1000

# Authentication rate limits
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=5

# Strict API rate limits
RATE_LIMIT_STRICT_WINDOW_MS=60000
RATE_LIMIT_STRICT_MAX=30

# Moderate API rate limits
RATE_LIMIT_MODERATE_WINDOW_MS=60000
RATE_LIMIT_MODERATE_MAX=100

# File upload rate limits
RATE_LIMIT_UPLOAD_WINDOW_MS=60000
RATE_LIMIT_UPLOAD_MAX=10

# ===========================================
# НАСТРОЙКИ ЛОГИРОВАНИЯ
# ===========================================
LOG_LEVEL=info
LOG_MAX_BODY_SIZE=10240
LOG_INCLUDE_BODY=false
LOG_INCLUDE_HEADERS=false
LOG_INCLUDE_RESPONSE=false
LOG_MASK_SENSITIVE_DATA=true
LOG_SKIP_HEALTH_CHECKS=true
LOG_EXCLUDE_PATHS=/health,/metrics,/favicon.ico

# ===========================================
# ПРОИЗВОДИТЕЛЬНОСТЬ И МОНИТОРИНГ
# ===========================================
METRICS_HISTORY_SIZE=1000
METRICS_WINDOW_MS=60000
CACHE_HIT_THRESHOLD=70
SLOW_REQUEST_THRESHOLD=1000
RESPONSE_TIME_ALERT_THRESHOLD=2000
ERROR_RATE_THRESHOLD=5

# ===========================================
# CORS И БЕЗОПАСНОСТЬ HEADERS
# ===========================================
FRONTEND_URL=https://yourdomain.com,https://app.yourdomain.com
CORS_MAX_AGE=86400
CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=Origin,X-Requested-With,Content-Type,Accept,Authorization,X-API-Key,X-Request-ID
CORS_EXPOSED_HEADERS=X-Total-Count,X-Page-Count,X-Rate-Limit-Limit,X-Rate-Limit-Remaining,X-Rate-Limit-Reset

# HSTS Settings
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

# Content Security Policy
CSP_DEFAULT_SRC='self'
CSP_STYLE_SRC='self' 'unsafe-inline' https://fonts.googleapis.com
CSP_FONT_SRC='self' https://fonts.gstatic.com
CSP_SCRIPT_SRC='self'
CSP_IMG_SRC='self' data: https:

# Session Settings
SESSION_TIMEOUT=1800000
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=900000

# ===========================================
# ВНЕШНИЕ API СЕРВИСЫ
# ===========================================

# OpenRouter AI API
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_TIMEOUT=30000
OPENROUTER_MAX_RETRIES=3

# SMS.RU Service
SMS_RU_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Email Configuration (Beget SMTP)
BEGET_SMTP_HOST=smtp.beget.com
BEGET_SMTP_PORT=587
BEGET_SMTP_USER=your-email@yourdomain.com
BEGET_SMTP_PASSWORD=your-smtp-password

EMAIL_TIMEOUT=30000

# ===========================================
# ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ
# ===========================================

# Static files
STATIC_PATH=/dist/public

# ===========================================
# VPS / DOCKER (My EPA: myepa.ru, epa-link.ru)
# ===========================================
# Доменные имена для Traefik labels в docker-compose.prod.yml
APP_DOMAIN=myepa.ru
APP_DOMAIN_ALT=epa-link.ru
# Встроенный исполнитель записи выключаем — запись делает отдельный воркер
DISABLE_RECORDING_EXECUTOR=true

# Beget S3 — нужен и web, и воркеру
BEGET_S3_ENDPOINT=https://s3.ru1.storage.beget.cloud
BEGET_S3_ACCESS_KEY=
BEGET_S3_SECRET_KEY=
BEGET_S3_BUCKET=
BEGET_S3_REGION=ru-1
# Базовый URL существующего CDN перед бакетом (без / на конце): ссылки на записи
# строятся как <PUBLIC_URL>/myepa/recordings/...
# Без него воркер сохранит в БД ссылки без хоста.
BEGET_S3_PUBLIC_URL=

# Двухфакторная аутентификация (требует колонок two_factor_* в users — сейчас их нет в БД)
ENABLE_2FA=false

# Воркер записи
WORKER_ID=vps-worker-1
MAX_WORKERS=1
SCHEDULED_TIME_TZ_OFFSET_H=3

# Публичный URL приложения (используется для OAuth redirect Stepik и заголовка OpenRouter)
APP_URL=https://yourdomain.com

# ===========================================
# ИНТЕГРАЦИИ (все необязательные: без ключа функция отключена)
# ===========================================

# Stepik OAuth. PLATFORM_TOKENS_ENCRYPTION_KEY — 64 hex-символа (AES-256), ключ нельзя менять
# после подключения пользователей: сохранённые токены перестанут расшифровываться.
# В приложении Stepik зарегистрируйте redirect URI: ${APP_URL}/auth/stepik/callback
STEPIK_CLIENT_ID=
STEPIK_CLIENT_SECRET=
PLATFORM_TOKENS_ENCRYPTION_KEY=
# API_BASE_URL=https://myepa.ru   # по умолчанию берётся APP_URL

# Платежи
DEFAULT_PAYMENT_PROVIDER=yookassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
ALFABANK_USERNAME=
ALFABANK_PASSWORD=

# Яндекс.Диск (сохранение записей/файлов)
YANDEX_DISK_TOKEN=
YANDEX_DISK_FOLDER_ID=

# Запись вебинаров: данные, которыми воркер заполняет форму входа, если не заданы в задаче
RECORDING_JOIN_NAME=
RECORDING_JOIN_EMAIL=
RECORDING_JOIN_PHONE=

# Токен для служебных запросов воркера/n8n (POST /api/recording/monitor/*, заголовок
# Authorization: Bearer <API_SECRET>). В production без него эти эндпоинты закрыты.
API_SECRET=

# ===========================================
# НЕОБЯЗАТЕЛЬНАЯ НАСТРОЙКА (значения по умолчанию в коде)
# ===========================================
# AI_MAX_TOKENS=1000
# AI_TEMPERATURE=0.7
# AI_TOP_P=1
# CACHE_DEFAULT_TTL=300000
# CACHE_DASHBOARD_TTL=
# UPLOAD_MAX_FILE_SIZE=20971520
# SESSION_REFRESH_TOKEN_MAX_AGE=604800000
# API_VERSION=1.0.0
# Воркер записи (по умолчанию заданы в docker-compose.prod.yml):
# POLL_INTERVAL_MS=5000
# HEARTBEAT_INTERVAL_MS=30000
# HEARTBEAT_TIMEOUT_MS=600000
# FRAME_RATE=15
# VIEWPORT_WIDTH=1920
# VIEWPORT_HEIGHT=1080
# MAX_PART_DURATION_MS=600000
# Почта отправляется через BEGET_SMTP_*; SMTP_HOST/SMTP_* в коде есть только в config/environment.ts
# (проверка при старте, значение по умолчанию localhost) и на отправку писем не влияют.

# ===========================================
# ИНСТРУКЦИИ ПО НАСТРОЙКЕ
# ===========================================

# 1. ОБЯЗАТЕЛЬНЫЕ ПЕРЕМЕННЫЕ (без них приложение не запустится):
#    - DATABASE_URL
#    - JWT_SECRET
#    - JWT_REFRESH_SECRET (в production обязателен)
#    - ENCRYPTION_KEY
#    - OPENROUTER_API_KEY
#    - BEGET_SMTP_HOST
#    - BEGET_SMTP_USER
#    - BEGET_SMTP_PASSWORD

# 2. РЕКОМЕНДУЕМЫЕ ДЛЯ PRODUCTION:
#    - FRONTEND_URL (для CORS)
##    - SESSION_SECRET

# 3. ОПЦИОНАЛЬНЫЕ (имеют значения по умолчанию):
#    - Все настройки rate limiting
#    - Все настройки логирования
#    - Все настройки производительности
#    - Все настройки CORS headers

# 4. КАК ПОЛУЧИТЬ API КЛЮЧИ:

# OpenRouter API:
# - Перейдите на https://openrouter.ai/keys
# - Создайте новый API ключ
# - Скопируйте и вставьте в OPENROUTER_API_KEY

# SMS.RU API:
# - Зарегистрируйтесь на https://sms.ru/
# - В личном кабинете получите API ключ
# - Скопируйте и вставьте в SMS_RU_API_KEY

# Beget SMTP:
# - Используйте настройки SMTP от вашего хостинг провайдера
# - Или настройте другой SMTP сервис (Gmail, Yandex, etc.)

# 5. ГЕНЕРАЦИЯ БЕЗОПАСНЫХ КЛЮЧЕЙ:
# Для генерации безопасных ключей используйте:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# или
# openssl rand -hex 32

# 6. НАСТРОЙКА DATABASE_URL:
# Формат: postgresql://username:password@hostname:port/database
# Пример: postgresql://myepa_user:password@localhost:5432/myepa_db

# 7. НАСТРОЙКА FRONTEND_URL:
# Укажите все домены, с которых разрешен доступ к API
# Разделяйте запятой: https://app.domain.com,https://admin.domain.com